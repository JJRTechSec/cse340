<%- include ('partials/header') %>
  <main>
    <h1>
      <%= title %>
    </h1>
   
    <h2><%= projectDetails.title %></h2>
    <p>
      <strong>Categories:</strong>
    
      <% categories.forEach((category, index)=> { %>
        <a href="/category/<%= category.category_id %>">
          <%= category.name %>
        </a>
        <%= index < categories.length - 1 ? ', ' : '' %>
      <% }) %></p>

    <p>When: <%= projectDetails.formattedDate %></p>
    <p>Where: <%= projectDetails.location %></p>
    <p>Organization: <a href="/organization/<%= projectDetails.organization_id %>"><%= projectDetails.name %></a></p>
    <p><%= projectDetails.description %></p>

    <% if (user) { %>
      <% if (isVolunteering) { %>
        <p>You are volunteering for this project.</p>
    
        <form action="/project/<%= projectDetails.project_id %>/remove-volunteer" method="POST">
          <button type="submit">
            Stop Volunteering
          </button>
        </form>
      <% } else { %>
        <form action="/project/<%= projectDetails.project_id %>/volunteer" method="POST">
          <button type="submit">
            Volunteer for this Project
          </button>
        </form>
        <% } %>
    <%} %>

    <% if (user && user.role_name==='admin' ) { %>
      <div class="admin-links">
        <a href="/edit-project/<%= projectDetails.project_id %>">
          Edit Project
        </a>
        <br>
        <a href="/assign-categories/<%= projectDetails.project_id %>">
          Assign Categories
        </a>
      </div>
    <%} %>   
    
  </main>

  <%- include('partials/footer') %>