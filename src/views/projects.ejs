<%- include('partials/header') %>
  <main class="projects">
    <h1>
      <%= title %>
    </h1>
    <h2>Upcoming Service Projects</h2>
    <ul>
      <% projects.forEach(project => { %>
        <li>
          <strong><%= project.formattedDate %>:</strong> 
          <a href='/project/<%= project.project_id %>'><%= project.title %></a>
          (<%= project.name %>)
        </li>
      <% }); %>
    </ul>

    <p><a href="/new-project">Create New Project</a></p>
  </main>

  <%- include('partials/footer') %>