<%- include('partials/header') %>

  <main class="users">
    <h1>
      <%= title %>
    </h1>

    <% if (users.length> 0) { %>
      <ul>
        <% users.forEach(user=> { %>
          <li>
            <h2>
              <%= user.name %>
            </h2>
            <p>
              <strong>Email:</strong>
              <%= user.email %>
            </p>
            <p>
              <strong>Role:</strong>
              <%= user.role_name %>
            </p>
          </li>
          <% }); %>
      </ul>
      <% } else { %>
        <p>No registered users found.</p>
        <% } %>
  </main>

<%- include('partials/footer') %>