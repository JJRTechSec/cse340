<%- include ('partials/header') %>
  <main>

    <div class="container">
      <h1><%= projectDetails.title %></h1>
      <h2>Assign Categories to Project</h2>

      <form action="/assign-categories/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
          <div class="categories">
            <% categories.forEach(category=> { %>
              <div class="category-option">
                <input type="checkbox" id="category-<%= category.category_id %>" name="categories"
                  value="<%= category.category_id %>">
                <label for="category-<%= category.category_id %>">
                  <%= category.name %>
                </label>
              </div>
            <% }) %>
          </div>
        </div>
        <button type="submit">Assign Categories</button>
      </form>
    </div>

  </main>
<%- include ('partials/footer') %>