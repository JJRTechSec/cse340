<%- include ('partials/header') %>
  <main>

    <div class="container">
      <h1><%= projectDetails.title %></h1>
      <h2>Assign Categories to Project</h2>

      <form action="/assign-categories/<%= projectDetails.project_id %>" method="POST">
        <div class="form-group">
          <label for="categories">Select Categories: *hold ctrl + left click to select multiple options*</label>
          <select id="categories" name="categories" size="5" multiple required>
            <% categories.forEach((category)=> { %>
              <option value="<%= category.category_id %>"><%= category.name %></option>
              <% })%>
          </select>
        </div>
        <button type="submit">Assign Categories</button>
      </form>
    </div>

  </main>
<%- include ('partials/footer') %>